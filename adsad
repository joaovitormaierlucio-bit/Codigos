let contador = 0;
let moeda = 0;
let qdm_nivel_1 = 10;
let qdm_nivel_2 = 20;
let qdm_nivel_3 = 30;
let qdm_nivel_4 = 40;
let qdm_nivel_5 = 50;

let limite = 10;
let forca_clique = 1;

function botaoclique() {
    contador += forca_clique;
    if (contador >= limite) {
        moeda += 1;
        limite += 10;
    }
}

function botaoupar1() {
    if (moeda >= qdm_nivel_1) {
        moeda -= qdm_nivel_1;
        qdm_nivel_1 += 10;
    }
}

function botaoupar2() {
    if (moeda >= qdm_nivel_2) {
        moeda -= qdm_nivel_2;
        forca_clique += 2;
    }
}

function botaoupar3() {
    if (moeda >= qdm_nivel_3) {
        moeda -= qdm_nivel_3;
        forca_clique += 4;
    }
}

function botaoupar4() {
    if (moeda >= qdm_nivel_4) {
        moeda -= qdm_nivel_4;
        forca_clique += 6;
    }
}

function botaoupar5() {
    if (moeda >= qdm_nivel_5) {
        moeda -= qdm_nivel_5;
        forca_clique += 8;
    }
}

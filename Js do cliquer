function m1ps() {

    if (moeda >= qdm_nivel_alto) {

        moeda -= qdm_nivel_alto;

        document.getElementById("moeda").textContent = moeda;

        salvarProgresso();

        setInterval(function() {

            contador += 1;

            document.getElementById("contador").textContent = contador;

            if (contador >= limite) {

                moeda += 1;
                limite += 10;

                document.getElementById("moeda").textContent = moeda;

            }

            salvarProgresso();

        }, 1000);

    } else {

        alert("dinheiro insuficiente");

    }
}

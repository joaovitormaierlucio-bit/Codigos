let contador = Number(localStorage.getItem("contador")) || 0;
let moeda = Number(localStorage.getItem("moeda")) || 0;

let qdm_nivel_alto = Number(localStorage.getItem("qdm_nivel_alto")) || 100;
let qdm_nivel_1 = Number(localStorage.getItem("qdm_nivel_1")) || 7;
let qdm_nivel_2 = Number(localStorage.getItem("qdm_nivel_2")) || 25;
let qdm_nivel_3 = Number(localStorage.getItem("qdm_nivel_3")) || 65;
let qdm_nivel_4 = Number(localStorage.getItem("qdm_nivel_4")) || 90;

let limite = Number(localStorage.getItem("limite")) || 10;
let forca_clique = Number(localStorage.getItem("forca_clique")) || 1;

let loja3 = 0;


// SALVAR PROGRESSO
function salvarProgresso() {

    localStorage.setItem("contador", contador);
    localStorage.setItem("moeda", moeda);

    localStorage.setItem("qdm_nivel_alto", qdm_nivel_alto);
    localStorage.setItem("qdm_nivel_1", qdm_nivel_1);
    localStorage.setItem("qdm_nivel_2", qdm_nivel_2);
    localStorage.setItem("qdm_nivel_3", qdm_nivel_3);
    localStorage.setItem("qdm_nivel_4", qdm_nivel_4);

    localStorage.setItem("limite", limite);
    localStorage.setItem("forca_clique", forca_clique);
}


// MOSTRAR O PROGRESSO SALVO
document.getElementById("contador").textContent = contador;
document.getElementById("moeda").textContent = moeda;



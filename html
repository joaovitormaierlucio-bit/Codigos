<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>game clicker online</title>
</head>

<body>

    <h1>
        game clicker
    </h1>

    <img class="imagem" src="moeda.png" alt="">

    <div>
        <button onclick="botaoclique()" class="botao_clique">
            clique aqui
        </button>

        <p id="contador">0</p>
    </div>

    <p id="moeda">0</p>

    <button onclick="loja1()">
        loja
    </button>

    <div id="texto" style="display: none;">
        <button onclick="m1ps()">
            mais um por segundo
        </button>
    </div>

    <div id="botoes" class="botoes">

        <button class="botao1" onclick="botaoupar1()">
            upar +1
        </button>

        <button class="botao2" onclick="botaoupar2()">
            upar +2
        </button>

        <button class="botao3" onclick="botaoupar5()">
            upar +5
        </button>

        <button class="botao4" onclick="botaoupar10()">
            upar +10
        </button>

    </div>

    <script src="script.js"></script>

</body>
</html>
